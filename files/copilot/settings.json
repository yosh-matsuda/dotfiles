{
  "beep": false,
  "copyOnSelect": true,
  "defaultPermissionMode": "allow-all",
  "effortLevel": "high",
  "enabledFeatureFlags": {
    "EXTENSIONS": true
  },
  "hooks": {
    "agentStop": [
      {
        "_vsCodeCompat": "Stop",
        "bash": "bash \"$HOME/.copilot/hooks/session-notify.sh\"",
        "timeoutSec": 10,
        "type": "command"
      },
      {
        "bash": "command -v node >/dev/null 2>&1 && node \"$HOME/.copilot/hooks/reply-language.mjs\" stop || true",
        "timeoutSec": 10,
        "type": "command"
      }
    ],
    "notification": [
      {
        "bash": "python3 \"$HOME/dotfiles/files/scripts/copilot-session-activity.py\" hook",
        "matcher": "agent_completed|agent_idle|shell_completed|shell_detached_completed",
        "timeoutSec": 10,
        "type": "command"
      }
    ],
    "preToolUse": [
      {
        "bash": "command -v node >/dev/null 2>&1 && node \"$HOME/.copilot/hooks/reply-language.mjs\" ask || true",
        "matcher": "ask_user",
        "timeoutSec": 5,
        "type": "command"
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "claude-opus-5.5",
  "showReasoning": false,
  "statusLine": {
    "command": "~/.copilot/statusline.sh",
    "padding": 1,
    "refreshInterval": 60,
    "type": "command"
  },
  "subagents": {
    "agents": {
      "code-review": {
        "effortLevel": "high",
        "model": "claude-opus-5.5"
      },
      "general-purpose": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "claude-opus-5.5"
      },
      "research": {
        "contextTier": "default",
        "effortLevel": "high",
        "model": "claude-opus-5.5"
      },
      "rubber-duck": {
        "effortLevel": "high",
        "model": "gpt-6-astra"
      },
      "security-review": {
        "contextTier": "default",
        "effortLevel": "high",
        "model": "claude-opus-5.5"
      }
    }
  },
  "theme": "github"
}
