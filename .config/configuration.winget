# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
# Windows applications and features that the dotfiles playbook in WSL relies on, for x64 and Arm64 machines.
# Apply with `winget configure -f .config/configuration.winget`, or through bootstrap.ps1.
# Check without changing anything with `winget configure test -f .config/configuration.winget`.
# Packages with `useLatest: true` are also upgraded to the latest version, like `winget upgrade`.
# WSL has none, because upgrading it restarts the WSL service and stops the running distributions;
# update it with `wsl --update`. VS Code has none, because it updates itself.
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
# Microsoft.Windows/OptionalFeatureList cannot be used: winget installs DSC from Microsoft Store, and its
# dism_dsc stops with "This resource currently is not supported when installed via Appx".
# EnablePending counts as enabled: the feature takes effect after a restart, which bootstrap.ps1 asks for.
- name: VirtualMachinePlatform
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Enable Virtual Machine Platform for WSL 2
    winget:
      securityContext: elevated
  properties:
    input:
      featureName: VirtualMachinePlatform
    getScript: |
      param($feature)
      $state = (Get-WindowsOptionalFeature -Online -FeatureName $feature.featureName).State
      @{ featureName = $feature.featureName; state = "$state" }
    testScript: |
      param($feature)
      "$((Get-WindowsOptionalFeature -Online -FeatureName $feature.featureName).State)" -in @('Enabled', 'EnablePending')
    setScript: |
      param($feature)
      Enable-WindowsOptionalFeature -Online -FeatureName $feature.featureName -All -NoRestart | Out-Null

- name: WSL
  type: Microsoft.WinGet/Package
  metadata:
    description: Install WSL
    winget:
      securityContext: elevated
  dependsOn:
  - VirtualMachinePlatform
  properties:
    id: Microsoft.WSL
    source: winget
    acceptAgreements: true

- name: Git
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Git for Windows
    winget:
      securityContext: elevated
  properties:
    id: Git.Git
    source: winget
    acceptAgreements: true
    useLatest: true

- name: VSCode
  type: Microsoft.WinGet/Package
  metadata:
    description: Install VS Code for the current user
  properties:
    id: Microsoft.VisualStudioCode
    source: winget
    acceptAgreements: true

- name: PowerShell
  type: Microsoft.WinGet/Package
  metadata:
    description: Install PowerShell 7
  properties:
    id: Microsoft.PowerShell
    source: winget
    acceptAgreements: true
    useLatest: true

- name: Coreutils
  type: Microsoft.WinGet/Package
  metadata:
    description: Install Coreutils for Windows
    winget:
      securityContext: elevated
  properties:
    id: Microsoft.Coreutils
    source: winget
    acceptAgreements: true
    useLatest: true

# A portable package for the current user; the Visual C++ runtime it depends on needs elevation,
# so the elevated VCRedist units install it first.
- name: uv
  type: Microsoft.WinGet/Package
  metadata:
    description: Install uv for the current user
  dependsOn:
  - VCRedist
  - VCRedistArm64
  properties:
    id: astral-sh.uv
    source: winget
    acceptAgreements: true
    useLatest: true

- name: VCRedist
  type: Microsoft.WinGet/Package
  metadata:
    description: Install the x64 Visual C++ runtime for WezTerm, and for uv on x64
    winget:
      securityContext: elevated
  properties:
    id: Microsoft.VCRedist.2015+.x64
    source: winget
    acceptAgreements: true
    useLatest: true

# uv for Arm64 depends on this separate package instead of the x64 one. winget configure cannot skip
# a unit by architecture, so the script reports the desired state on other machines and otherwise
# runs the Microsoft.WinGet/Package resource through dsc.exe.
- name: VCRedistArm64
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Install the Arm64 Visual C++ runtime that uv requires on Arm64
    winget:
      securityContext: elevated
  properties:
    input:
      id: Microsoft.VCRedist.2015+.arm64
      source: winget
      acceptAgreements: true
      useLatest: true
    testScript: |
      param($package)
      # The registry holds the native architecture; an emulated process sees AMD64 in its environment.
      $architecture = (Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment').PROCESSOR_ARCHITECTURE
      if ($architecture -ne 'ARM64') { return $true }
      # Windows PowerShell drops the quotes inside a native argument, so the JSON goes through a file.
      $inputFile = Join-Path $env:TEMP "dotfiles-$([guid]::NewGuid()).json"
      $package | ConvertTo-Json -Compress | Set-Content -LiteralPath $inputFile -Encoding ASCII
      try {
        $ErrorActionPreference = 'Continue'
        $result = dsc.exe resource test -r Microsoft.WinGet/Package --file $inputFile 2>$null
        if ($LASTEXITCODE -ne 0) { throw "dsc.exe resource test failed with exit code $LASTEXITCODE" }
      } finally {
        Remove-Item -LiteralPath $inputFile -Force -ErrorAction SilentlyContinue
      }
      [bool](($result | Out-String) | ConvertFrom-Json).inDesiredState
    setScript: |
      param($package)
      $inputFile = Join-Path $env:TEMP "dotfiles-$([guid]::NewGuid()).json"
      $package | ConvertTo-Json -Compress | Set-Content -LiteralPath $inputFile -Encoding ASCII
      try {
        $ErrorActionPreference = 'Continue'
        dsc.exe resource set -r Microsoft.WinGet/Package --file $inputFile 2>$null | Out-Null
        if ($LASTEXITCODE -ne 0) { throw "dsc.exe resource set failed with exit code $LASTEXITCODE" }
      } finally {
        Remove-Item -LiteralPath $inputFile -Force -ErrorAction SilentlyContinue
      }

# The winget package wez.wezterm.nightly pins the SHA256 of a file that the nightly tag replaces,
# so its install fails on a hash mismatch; wez.wezterm is the 20240203 release.
# The test passes for any installed WezTerm, so a rerun never replaces it; rerunning the installer updates it.
- name: WezTerm
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Install the WezTerm nightly build
    winget:
      securityContext: elevated
  dependsOn:
  - VCRedist
  properties:
    input:
      url: https://github.com/wezterm/wezterm/releases/download/nightly/WezTerm-nightly-setup.exe
      # The AppId of the WezTerm Inno Setup installer
      uninstallKey: HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{BCF6F0DA-5B9A-408D-8562-F680AE6E1EAF}_is1
    getScript: |
      param($config)
      $item = Get-ItemProperty -LiteralPath $config.uninstallKey -ErrorAction SilentlyContinue
      @{ installed = $null -ne $item; version = $item.DisplayVersion }
    testScript: |
      param($config)
      Test-Path -LiteralPath $config.uninstallKey
    setScript: |
      param($config)
      $ProgressPreference = 'SilentlyContinue'
      $installer = Join-Path $env:TEMP 'WezTerm-nightly-setup.exe'
      Invoke-WebRequest -UseBasicParsing -Uri $config.url -OutFile $installer
      try {
        $process = Start-Process -FilePath $installer -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/SP-' -Wait -PassThru
        if ($process.ExitCode -ne 0) { throw "WezTerm installer exited with code $($process.ExitCode)" }
      } finally {
        Remove-Item -LiteralPath $installer -Force -ErrorAction SilentlyContinue
      }

# wezterm.lua uses UDEV Gothic NFLG; no winget package provides UDEV Gothic.
- name: UDEVGothicNF
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Install the UDEV Gothic NF fonts for all users
    winget:
      securityContext: elevated
  properties:
    input:
      version: v2.2.0
      variants: [NF, NFLG, 35NF, 35NFLG]
      styles: [Regular, Bold, Italic, BoldItalic]
    getScript: |
      param($config)
      $fontsDir = Join-Path $env:windir 'Fonts'
      $files = foreach ($variant in $config.variants) { foreach ($style in $config.styles) { "UDEVGothic$variant-$style.ttf" } }
      @{ missing = @($files | Where-Object { -not (Test-Path -LiteralPath (Join-Path $fontsDir $_)) }) }
    testScript: |
      param($config)
      $fontsDir = Join-Path $env:windir 'Fonts'
      $registered = Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      $missing = foreach ($variant in $config.variants) {
        foreach ($style in $config.styles) {
          $file = "UDEVGothic$variant-$style.ttf"
          $name = "UDEV Gothic $variant $style (TrueType)"
          if (-not (Test-Path -LiteralPath (Join-Path $fontsDir $file)) -or $registered.$name -ne $file) { $file }
        }
      }
      @($missing).Count -eq 0
    setScript: |
      param($config)
      $ProgressPreference = 'SilentlyContinue'
      $fontsDir = Join-Path $env:windir 'Fonts'
      $registryKey = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      $archiveName = "UDEVGothic_NF_$($config.version)"
      $work = Join-Path $env:TEMP "dotfiles-$archiveName"
      $zip = "$work.zip"
      Invoke-WebRequest -UseBasicParsing -Uri "https://github.com/yuru7/udev-gothic/releases/download/$($config.version)/$archiveName.zip" -OutFile $zip
      try {
        Expand-Archive -LiteralPath $zip -DestinationPath $work -Force
        Add-Type -Namespace Dotfiles -Name Gdi32 -MemberDefinition '[DllImport("gdi32.dll", CharSet = CharSet.Unicode)] public static extern int AddFontResource(string file);'
        foreach ($variant in $config.variants) {
          foreach ($style in $config.styles) {
            $file = "UDEVGothic$variant-$style.ttf"
            $target = Join-Path $fontsDir $file
            # A font in use cannot be overwritten, so an existing file is kept.
            if (-not (Test-Path -LiteralPath $target)) {
              Copy-Item -LiteralPath (Join-Path (Join-Path $work $archiveName) $file) -Destination $target
            }
            Set-ItemProperty -LiteralPath $registryKey -Name "UDEV Gothic $variant $style (TrueType)" -Value $file
            # Lets running applications see the font without a new sign-in.
            [void][Dotfiles.Gdi32]::AddFontResource($target)
          }
        }
      } finally {
        Remove-Item -LiteralPath $zip, $work -Recurse -Force -ErrorAction SilentlyContinue
      }

# Swaps the left Ctrl and CapsLock (Eisu on JIS) keys, and the Hankaku/Zenkaku and Henkan keys, for every user.
# The keyboard driver rewrites the scancodes, so the swaps hold in elevated windows and at sign-in without kanata.
# Windows reads the value at startup, so a change takes effect after a restart.
# Layout: version and flags, the entry count including the terminator, then one line per entry with the new
# and the original scancode as little-endian 16-bit words: 0x1D left Ctrl, 0x3A CapsLock, 0x29 Hankaku/Zenkaku,
# 0x79 Henkan.
- name: ScancodeMap
  type: Microsoft.Windows/Registry
  metadata:
    description: Swap left Ctrl with CapsLock, and Hankaku/Zenkaku with Henkan
    winget:
      securityContext: elevated
  properties:
    keyPath: HKLM\SYSTEM\CurrentControlSet\Control\Keyboard Layout
    valueName: Scancode Map
    valueData:
      Binary: [
        0, 0, 0, 0, 0, 0, 0, 0, 5, 0, 0, 0,
        58, 0, 29, 0,
        29, 0, 58, 0,
        121, 0, 41, 0,
        41, 0, 121, 0,
        0, 0, 0, 0]

# kanata runs elevated so that its layer works in elevated windows too, so its executables and its config live
# under Program Files, where only administrators can change them. The release is pinned: v1.12.0, the latest
# one in winget, always compares its keys with the Windows key state by US virtual-key codes, and on JIS the
# key right of l differs, so every ; raised an "Unexpected keycode" error. The prerelease adds
# windows-sync-keystates none, which KanataConfig sets. The release publishes no checksums, so the hashes are
# those of the files downloaded on 2026-10-27. The unit also removes jtroo.kanata_gui that earlier versions of
# this file installed with winget, and keeps the files writable only by SYSTEM, Administrators, and
# TrustedInstaller.
- name: KanataPackage
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Install kanata for all users
    winget:
      securityContext: elevated
  dependsOn:
  - VCRedist
  - VCRedistArm64
  properties:
    input:
      version: v1.13.0-prerelease-1
      installDir: kanata
      oldPackageId: jtroo.kanata_gui
      files:
        x64:
          kanata_windows_gui_winIOv2_x64.exe: f2d6166b0118523af67a11ad7cccd67231de41058cdb3fafe0405933a6276206
          kanata_windows_tty_winIOv2_x64.exe: 3812373ccfd88ee8fd86c57a084e0dd4a615a6ff2e01db2934a8051d5bf225f3
        arm64:
          kanata_windows_gui_winIOv2_arm64.exe: afd3a564c3fce21cf21a158547855d68a162a3fdf2ea43159bcbaa9ee2e10512
          kanata_windows_tty_winIOv2_arm64.exe: 7a48531715ec68a25fe9976eff8b2ac4589577c0f8a6d7e8ecb5376897d47ff1
    testScript: |
      param($package)
      # The registry holds the native architecture; an emulated process sees AMD64 in its environment.
      $architecture = (Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment').PROCESSOR_ARCHITECTURE
      $arch = if ($architecture -eq 'ARM64') { 'arm64' } else { 'x64' }
      $directory = Get-Item -LiteralPath (Join-Path $env:ProgramFiles $package.installDir) -ErrorAction SilentlyContinue
      if (-not $directory) { return $false }
      foreach ($file in $package.files.$arch.PSObject.Properties) {
        $path = Join-Path $directory.FullName $file.Name
        if (-not (Test-Path -LiteralPath $path)) { return $false }
        if ((Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash -ne $file.Value) { return $false }
      }
      if (Test-Path -Path (Join-Path $env:ProgramFiles "WinGet\Packages\$($package.oldPackageId)_*")) { return $false }
      $trusted = @('S-1-5-18', 'S-1-5-32-544', 'S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464')
      # Write, delete, permission, and ownership rights, including GENERIC_ALL and GENERIC_WRITE
      $writeMask = 0x50000000 -bor [int][Security.AccessControl.FileSystemRights]'Write, Delete, DeleteSubdirectoriesAndFiles, ChangePermissions, TakeOwnership'
      foreach ($item in @($directory) + @(Get-ChildItem -LiteralPath $directory.FullName -Recurse -Force)) {
        $acl = Get-Acl -LiteralPath $item.FullName
        if ($acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -notin $trusted) { return $false }
        foreach ($rule in $acl.GetAccessRules($true, $true, [Security.Principal.SecurityIdentifier])) {
          if ($rule.AccessControlType -ne 'Allow' -or $rule.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) { continue }
          if (([int]$rule.FileSystemRights -band $writeMask) -and $rule.IdentityReference.Value -notin $trusted) { return $false }
        }
      }
      $true
    setScript: |
      param($package)
      $ProgressPreference = 'SilentlyContinue'
      $architecture = (Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment').PROCESSOR_ARCHITECTURE
      $arch = if ($architecture -eq 'ARM64') { 'arm64' } else { 'x64' }
      $installDir = Join-Path $env:ProgramFiles $package.installDir
      # A running kanata locks its executable; the KanataTask unit starts it again.
      Get-Process -Name 'kanata_windows_*' -ErrorAction SilentlyContinue | Stop-Process -Force
      if (Test-Path -Path (Join-Path $env:ProgramFiles "WinGet\Packages\$($package.oldPackageId)_*")) {
        $ErrorActionPreference = 'Continue'
        winget.exe uninstall --id $package.oldPackageId --exact --scope machine --disable-interactivity | Out-Null
        $ErrorActionPreference = 'Stop'
        if (Test-Path -Path (Join-Path $env:ProgramFiles "WinGet\Packages\$($package.oldPackageId)_*")) {
          throw "winget uninstall $($package.oldPackageId) failed with exit code $LASTEXITCODE"
        }
      }
      $work = Join-Path $env:TEMP "dotfiles-kanata-$([guid]::NewGuid())"
      New-Item -ItemType Directory -Force -Path $work | Out-Null
      try {
        $zip = Join-Path $work 'kanata.zip'
        Invoke-WebRequest -UseBasicParsing -Uri "https://github.com/jtroo/kanata/releases/download/$($package.version)/windows-binaries-$arch.zip" -OutFile $zip
        Expand-Archive -LiteralPath $zip -DestinationPath $work -Force
        New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        foreach ($file in $package.files.$arch.PSObject.Properties) {
          $source = Join-Path $work $file.Name
          $hash = (Get-FileHash -LiteralPath $source -Algorithm SHA256).Hash
          if ($hash -ne $file.Value) { throw "$($file.Name) has SHA256 $hash, expected $($file.Value)" }
          Copy-Item -LiteralPath $source -Destination (Join-Path $installDir $file.Name) -Force
        }
      } finally {
        Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
      }
      icacls.exe $installDir /setowner '*S-1-5-32-544' /T /C /Q | Out-Null
      if ($LASTEXITCODE -ne 0) { throw "icacls /setowner failed with exit code $LASTEXITCODE" }
      icacls.exe $installDir /reset /T /C /Q | Out-Null
      if ($LASTEXITCODE -ne 0) { throw "icacls /reset failed with exit code $LASTEXITCODE" }

- name: KanataConfig
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Write the kanata config
    winget:
      securityContext: elevated
  properties:
    input:
      path: dotfiles\kanata.kbd
      # The Ctrl and CapsLock swap and the Henkan and Hankaku/Zenkaku swap are in ScancodeMap.
      # Muhenkan is only a layer key and sends nothing itself, so no tap timing can misfire.
      # Keys outside defsrc never pass through kanata. windows-sync-keystates none stops the check that compares
      # the keys with US virtual-key codes, which misreads ; on JIS; see KanataPackage.
      content: |
        ;; Hold Muhenkan for the navigation layer.
        (defcfg
          process-unmapped-keys no
          windows-sync-keystates none
        )

        (defsrc
          mhnk
          u i o
          a d h j k l ;
          spc
        )

        (deflayer base
          (layer-while-held nav)
          u i o
          a d h j k l ;
          spc
        )

        (deflayer nav
          _
          pgup up pgdn
          home del bspc left down right end
          ret
        )
    testScript: |
      param($config)
      $path = Join-Path $env:ProgramFiles $config.path
      (Test-Path -LiteralPath $path) -and ([IO.File]::ReadAllText($path) -ceq $config.content)
    setScript: |
      param($config)
      $path = Join-Path $env:ProgramFiles $config.path
      New-Item -ItemType Directory -Force -Path (Split-Path -Parent $path) | Out-Null
      [IO.File]::WriteAllText($path, $config.content, (New-Object Text.UTF8Encoding $false))

# The task starts kanata elevated at sign-in without a UAC prompt, and a time trigger in the past with an endless
# repetition starts it again every minute. IgnoreNew skips a run while kanata runs, so kanata comes back within
# a minute after it exits for any reason. The restart-on-failure setting of a task does not react to a process
# that exits, and the repetition of a logon trigger starts only at the next sign-in, not when the task is
# registered and started by hand.
# A task runs below normal priority and stops after 72 hours by default; both would hurt a keyboard hook.
# The test restarts kanata when it is not running or started before the config was last written.
- name: KanataTask
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  metadata:
    description: Start kanata elevated at sign-in
    winget:
      securityContext: elevated
  dependsOn:
  - KanataPackage
  - KanataConfig
  properties:
    input:
      installDir: kanata
      configPath: dotfiles\kanata.kbd
      taskPath: \dotfiles\
      taskName: kanata
      # Change it when the task definition below changes, so the test re-registers the task.
      revision: 4
    testScript: |
      param($task)
      # The registry holds the native architecture; an emulated process sees AMD64 in its environment.
      $architecture = (Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment').PROCESSOR_ARCHITECTURE
      $exeName = if ($architecture -eq 'ARM64') { 'kanata_windows_gui_winIOv2_arm64.exe' } else { 'kanata_windows_gui_winIOv2_x64.exe' }
      $exe = Get-Item -LiteralPath (Join-Path (Join-Path $env:ProgramFiles $task.installDir) $exeName) -ErrorAction SilentlyContinue
      $config = Get-Item -LiteralPath (Join-Path $env:ProgramFiles $task.configPath) -ErrorAction SilentlyContinue
      if (-not $exe -or -not $config) { return $false }
      $description = "Starts kanata elevated at sign-in. Managed by dotfiles, revision $($task.revision): $($exe.FullName) --cfg `"$($config.FullName)`""
      $registered = Get-ScheduledTask -TaskPath $task.taskPath -TaskName $task.taskName -ErrorAction SilentlyContinue
      if (-not $registered -or $registered.Description -ne $description) { return $false }
      $running = @(Get-Process -Name $exe.BaseName -ErrorAction SilentlyContinue | Where-Object { $_.Path -eq $exe.FullName -and $_.StartTime -gt $config.LastWriteTime })
      $running.Count -gt 0
    setScript: |
      param($task)
      $architecture = (Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment').PROCESSOR_ARCHITECTURE
      $exeName = if ($architecture -eq 'ARM64') { 'kanata_windows_gui_winIOv2_arm64.exe' } else { 'kanata_windows_gui_winIOv2_x64.exe' }
      $exe = Get-Item -LiteralPath (Join-Path (Join-Path $env:ProgramFiles $task.installDir) $exeName) -ErrorAction SilentlyContinue
      $config = Get-Item -LiteralPath (Join-Path $env:ProgramFiles $task.configPath) -ErrorAction SilentlyContinue
      if (-not $exe) { throw "$exeName was not found; the KanataPackage unit installs it" }
      if (-not $config) { throw "$($task.configPath) was not found; the KanataConfig unit writes it" }
      $description = "Starts kanata elevated at sign-in. Managed by dotfiles, revision $($task.revision): $($exe.FullName) --cfg `"$($config.FullName)`""
      $user = [Security.Principal.WindowsIdentity]::GetCurrent().Name
      $action = New-ScheduledTaskAction -Execute $exe.FullName -Argument "--cfg `"$($config.FullName)`""
      $atLogOn = New-ScheduledTaskTrigger -AtLogOn -User $user
      # A repetition without a duration repeats indefinitely.
      $everyMinute = New-ScheduledTaskTrigger -Once -At (Get-Date).Date -RepetitionInterval (New-TimeSpan -Minutes 1)
      $principal = New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel Highest
      $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
        -ExecutionTimeLimit ([TimeSpan]::Zero) -Priority 4 -MultipleInstances IgnoreNew
      Register-ScheduledTask -TaskPath $task.taskPath -TaskName $task.taskName -Description $description `
        -Action $action -Trigger @($atLogOn, $everyMinute) -Principal $principal -Settings $settings -Force | Out-Null
      Stop-ScheduledTask -TaskPath $task.taskPath -TaskName $task.taskName
      Get-Process -Name $exe.BaseName -ErrorAction SilentlyContinue | Stop-Process -Force
      for ($i = 0; $i -lt 20 -and (Get-ScheduledTask -TaskPath $task.taskPath -TaskName $task.taskName).State -eq 'Running'; $i++) {
        Start-Sleep -Milliseconds 500
      }
      Start-ScheduledTask -TaskPath $task.taskPath -TaskName $task.taskName
